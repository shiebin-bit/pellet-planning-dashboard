# Standalone server/development only. Desktop configuration is managed separately
# under %LOCALAPPDATA%\FFM\MillPlan. Never commit your real .env.
POSTGRES_DB=millplan
POSTGRES_USER=millplan
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
# Use an existing native PostgreSQL database; create the role/database privately.
DATABASE_URL=postgresql://millplan:replace-with-a-long-random-hex-password@127.0.0.1:5434/millplan
HOST=127.0.0.1
PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:5178,http://localhost:5178
AUTOMATIC_BACKUP_ENABLED=true
# Optional absolute path. If omitted the standalone server uses backups/automatic.
AUTOMATIC_BACKUP_INTERVAL_HOURS=24
AUTOMATIC_BACKUP_RETENTION_COUNT=14
# For a reverse proxy, append its exact HTTPS origin. Keep the app/database bound to loopback.
# Example: ALLOWED_ORIGINS=http://127.0.0.1:5178,http://localhost:5178,https://planning.example.com
