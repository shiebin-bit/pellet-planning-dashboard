# The setup script creates .env with a random password. Never commit .env.
POSTGRES_DB=millplan
POSTGRES_USER=millplan
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
APP_PORT=8080

# Used by npm start/server:dev outside Docker, with compose.dev.yml enabled.
# Docker Compose supplies its own internal DATABASE_URL to the app service.
DATABASE_URL=postgresql://millplan:replace-with-a-long-random-hex-password@127.0.0.1:5434/millplan
HOST=127.0.0.1
PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:5178,http://localhost:5178
