{
  "name": "pellet-planning-dashboard",
  "private": true,
  "version": "0.2.0",
  "description": "Four-line pellet planning dashboard with SAP Excel imports, stock ledger, order progress, reviewed automatic scheduling and PostgreSQL persistence.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "server:dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "seed:demo-history": "node --env-file-if-exists=.env --import tsx scripts/seed-demo-history.ts",
    "test:api": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/api.test.ts tests/inventory-api.test.ts",
    "test:browser": "node tests/browser.cjs && node tests/browser-efficiency.cjs && node tests/browser-pause-audit.cjs && node tests/browser-ui.cjs && node tests/browser-data.cjs && node tests/browser-inventory.cjs && node tests/browser-table-ux.cjs && node tests/browser-settings-preview.cjs && node tests/browser-list-navigation.cjs",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
