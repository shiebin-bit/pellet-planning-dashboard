{
  "name": "pellet-planning-dashboard",
  "private": true,
  "version": "0.2.0",
  "description": "Four-line pellet production planning dashboard with drag-and-drop scheduling, PostgreSQL persistence and Excel/PDF reports.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "server:dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "seed:demo-history": "node --env-file-if-exists=.env --import tsx scripts/seed-demo-history.ts",
    "test:api": "node --env-file-if-exists=.env --import tsx --test tests/api.test.ts",
    "test:browser": "node tests/browser.cjs && node tests/browser-efficiency.cjs && node tests/browser-pause-audit.cjs && node tests/browser-ui.cjs",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
